DB_HOST=mysql
DB_PORT=3307
DB_NAME=marluse
DB_USER=root
DB_PASSWORD=
DB_USE_SSL=false   # trocar para true quando usar banco externo (RDS, Railway, etc.)
JWT_SECRET=
CORS_ORIGIN=https://SEU_DOMINIO_AQUI   # trocar pelo domínio real em produção
ADMIN_EMAIL=
ADMIN_SENHA=

# --- Demo (portfólio) ---
# Ative o profile demo somando-o ao docker:
SPRING_PROFILES_ACTIVE=docker,demo
# Login público mostrado na tela (também definido em application-demo.yml):
# app.demo.usuario-email=demo@marluse.com / app.demo.usuario-senha=demo123
# Intervalo de reset em ms (default 6h): APP_DEMO_RESET_INTERVAL_MS=21600000
